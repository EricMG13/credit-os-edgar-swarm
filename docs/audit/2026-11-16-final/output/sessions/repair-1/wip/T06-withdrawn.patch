+import { useEffect } from "react";
+import { act, cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { ConnectedApp } from "./ConnectedApp";
+
+// A page that manages its own focus, as the Start a run steps do: it puts focus on its heading
+// when it opens, and the shell must leave that alone.
+vi.mock("./StartRun", () => ({
+  StartRun: function StartRun() {
+    useEffect(() => {
+      document.getElementById("own-heading")?.focus();
+    }, []);
+    return (
+      <h2 id="own-heading" tabIndex={-1}>
+        Start a run
+      </h2>
+    );
+  },
+}));
+
+// The pages are lazy chunks; load them once up front so a slow first import cannot make a
+// focus assertion wait on the chunk instead of on the focus.
+beforeAll(async () => {
+  await Promise.all([
+    import("./LibraryIndex"),
+    import("./ReportLibrary"),
+    import("./RunActivity"),
+    import("./RunProgress"),
+  ]);
+}, 30_000);
+
+// Nothing the pages ask for ever arrives, so each page stays in its loading state: the focus has
+// to land and stay where it is whatever the page does next.
+beforeEach(() => {
+  vi.stubGlobal(
+    "fetch",
+    vi.fn(() => new Promise<Response>(() => undefined)),
+  );
+  window.location.hash = "";
+  (document.activeElement as HTMLElement | null)?.blur();
+});
+
+afterEach(() => {
+  cleanup();
+  vi.unstubAllGlobals();
+});
+
+const main = () => screen.getByRole("main");
+
+describe("a page opening in the connected app", () => {
+  it.each([
+    ["the library", "/"],
+    ["the run list", "/runs"],
+    ["a run", "/run/20261117-000000-77"],
+    ["a report", "/report/20261117-000000-77"],
+    ["an unknown address", "/nowhere"],
+  ])("moves keyboard focus to the page region for %s", async (_name, path) => {
+    render(<ConnectedApp path={path} mode="synthetic" />);
+    await waitFor(() => {
+      expect(document.activeElement).toBe(main());
+    });
+  });
+
+  it("leaves focus where the page itself put it", async () => {
+    render(<ConnectedApp path="/start" mode="synthetic" />);
+    const heading = await screen.findByRole("heading", { name: "Start a run" });
+    expect(document.activeElement).toBe(heading);
+  });
+
+  it("moves focus into the new page when the address changes under a control outside it", async () => {
+    const { rerender } = render(<ConnectedApp path="/nowhere" mode="synthetic" />);
+    await waitFor(() => {
+      expect(document.activeElement).toBe(main());
+    });
+    const rail = screen.getByRole("link", { name: "Run" });
+    rail.focus();
+    rerender(<ConnectedApp path="/elsewhere" mode="synthetic" />);
+    await waitFor(() => {
+      expect(document.activeElement).toBe(main());
+    });
+  });
+
+  it("does not take focus back from inside the page when it changes address", async () => {
+    const { rerender } = render(<ConnectedApp path="/nowhere" mode="synthetic" />);
+    await waitFor(() => {
+      expect(document.activeElement).toBe(main());
+    });
+    const control = within(main()).getByRole("link", { name: "Library" });
+    control.focus();
+    rerender(<ConnectedApp path="/elsewhere" mode="synthetic" />);
+    await act(async () => {
+      await Promise.resolve();
+    });
+    expect(document.activeElement).toBe(control);
+  });
+
+  it("does not move focus when only the hash changes inside a report", async () => {
+    render(<ConnectedApp path="/report/20261117-000000-77" mode="synthetic" />);
+    await waitFor(() => {
+      expect(document.activeElement).toBe(main());
+    });
+    // Focus lost to the body, as it is when the control that was pressed has gone.
+    (document.activeElement as HTMLElement).blur();
+    expect(document.activeElement).toBe(document.body);
+    await act(async () => {
+      window.location.hash = "#evidence";
+      window.dispatchEvent(new HashChangeEvent("hashchange"));
+      await Promise.resolve();
+    });
+    expect(document.activeElement).toBe(document.body);
+  });
+
+  it("keeps Skip to content working", async () => {
+    render(<ConnectedApp path="/nowhere" mode="synthetic" />);
+    await waitFor(() => {
+      expect(document.activeElement).toBe(main());
+    });
+    screen.getByRole("link", { name: "Run" }).focus();
+    expect(document.activeElement).not.toBe(main());
+    // A cancelled click is what stops the browser from changing the hash.
+    expect(fireEvent.click(screen.getByRole("link", { name: "Skip to content" }))).toBe(false);
+    expect(document.activeElement).toBe(main());
+    expect(window.location.hash).toBe("");
+  });
+});
